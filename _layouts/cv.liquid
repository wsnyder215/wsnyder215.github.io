---
layout: default
---

<div class="post">

  <header class="post-header">
    <h1 class="post-title">{{ page.title }} {% if page.cv_pdf %}<a href="{{ page.cv_pdf | prepend: site.baseurl | replace: '//', '/' }}" target="_blank" title="Download CV" class="float-right"><i class="fa-solid fa-file-pdf"></i></a>{% endif %}</h1>
    {% if page.description %}
    <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    <div class="cv">
      <embed src="{{ page.cv_pdf | prepend: site.baseurl | replace: '//', '/' }}" type="application/pdf" width="100%" height="600px" />
    </div>
  </article>

</div>
